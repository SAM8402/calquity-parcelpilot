# ParcelPilot / CalQuity — required env
# Paste Google AI Studio key(s). Comma-separated keys are supported.
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_FALLBACK_CHAIN=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-2.5-pro
EMBEDDING_MODEL=models/gemini-embedding-001

# CORS — JSON array or comma-separated both work
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Frontend (Next.js rewrite target)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Redis — leave EMPTY on Render (uses fakeredis). For local Docker Redis:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
CACHE_TTL_CHAT=600
CACHE_TTL_DOCS=3600
CACHE_TTL_DATA=300

# Render / Docker: see DEPLOY_RENDER.md (Gyansetu-style single service)
